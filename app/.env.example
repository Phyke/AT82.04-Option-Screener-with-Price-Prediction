# Public hostname or IP where the VPS is reachable from your browser.
# Used to build the frontend's VITE_API_URL and to allow CORS from the UI.
PUBLIC_HOST=123.45.67.89

# Host ports. Defaults put the UI on :80 and the API on :8000.
FRONTEND_PORT=80
BACKEND_PORT=8000

# --- Backend ---
LOG_LEVEL=INFO
REDIS_PREFIX=options-app
OPTION_CHAIN_TTL_SECONDS=300
DAILY_HISTORY_TTL_SECONDS=86400
YF_CONCURRENCY=8

# Optional: override the CORS regex. Leave unset to auto-derive from PUBLIC_HOST.
# CORS_ORIGIN_REGEX=^http://my\.host\.com(:\d+)?$

# --- Image tags (override if you push to a registry) ---
BACKEND_IMAGE=options-screener-backend:latest
FRONTEND_IMAGE=options-screener-frontend:latest
