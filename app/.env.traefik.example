# The hostname your VPS is reachable at.
# Same value is used by Traefik routing and baked into the frontend.
DOMAIN=vps.example.com

# Email Let's Encrypt uses for expiry/rekey notifications.
ACME_EMAIL=you@example.com

# --- Backend tuning ---
LOG_LEVEL=INFO
REDIS_PREFIX=options-app
OPTION_CHAIN_TTL_SECONDS=300
DAILY_HISTORY_TTL_SECONDS=86400
YF_CONCURRENCY=8

# Optional extra CORS regex (advanced). Leave blank.
CORS_ORIGIN_REGEX=

# --- Image tags (override if you push to a registry) ---
BACKEND_IMAGE=options-screener-backend:latest
FRONTEND_IMAGE=options-screener-frontend:latest
